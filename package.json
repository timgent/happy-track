{
  "name": "happy-track",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "preview": "vite preview",
    "test": "npm run typecheck && vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:ui": "npm run build && playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report",
    "prepare": "husky",
    "build:mobile": "tsc -b && vite build && npx cap copy",
    "cap:sync": "tsc -b && vite build && npx cap sync",
    "cap:ios": "npm run build && npx cap sync ios && npx cap open ios",
    "cap:android": "npm run build && npx cap sync android && npx cap open android",
    "build:android-release": "npm run build && npx cap sync android && cd android && ./gradlew bundleRelease"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.4",
    "@capacitor/app": "^8.1.0",
    "@capacitor/cli": "^8.3.4",
    "@capacitor/core": "^8.3.4",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.3.4",
    "@heroicons/react": "^2.2.0",
    "@inrupt/solid-client": "^2.1.2",
    "@inrupt/vocab-common-rdf": "^1.0.5",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@sentry/capacitor": "4.2.0",
    "@sentry/react": "10.60.0",
    "@tailwindcss/vite": "^4.1.4",
    "@types/pouchdb": "^6.4.2",
    "@uvdsl/solid-oidc-client-browser": "^0.2.2",
    "@vercel/analytics": "^1.5.0",
    "@vercel/functions": "^3.9.5",
    "events": "^3.3.0",
    "jose": "^5.10.0",
    "n3": "^1.26.0",
    "pouchdb": "^9.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.6.0",
    "tailwindcss": "^4.1.4",
    "use-debounce": "^10.0.5",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@playwright/test": "^1.59.1",
    "@solid/community-server": "^7.1.9",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/jsonld": "^1.5.15",
    "@types/n3": "^1.26.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/ui": "^4.0.8",
    "eslint": "^9.22.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "happy-dom": "^20.0.10",
    "husky": "^9.1.7",
    "jsonld": "^9.0.0",
    "pouchdb-adapter-memory": "^9.0.0",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.26.1",
    "vite": "^6.3.1",
    "vitest": "^4.0.8"
  }
}
